{% comment %}
  Renders one promise-badge icon from a fixed set. Decorative only: the label
  next to it carries the meaning, so the icon is aria-hidden and focusable=false.

  Accepts:
    icon - one of: leaf, shield, no-harsh, drop, sparkle, recycle
{% endcomment %}
{%- liquid
  assign icon = icon | default: 'leaf'
-%}
<svg class="hero-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'leaf' -%}
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/>
    {%- when 'no-harsh' -%}
      <circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/>
    {%- when 'drop' -%}
      <path d="M12 3c3 4 6 7.2 6 10.5A6 6 0 0 1 6 13.5C6 10.2 9 7 12 3Z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="M12 8.5 13.2 11 15.5 12 13.2 13 12 15.5 10.8 13 8.5 12 10.8 11 12 8.5Z"/>
    {%- when 'recycle' -%}
      <path d="M7 7 9.5 3l3 5M17 8l2.5 4-4.5 1M9 20l-4-1 1-4.5M14.5 20H19"/>
    {%- else -%}
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
  {%- endcase -%}
</svg>
