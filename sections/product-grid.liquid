{{ 'section-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-add.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign scene = section.settings.scene | default: 3
  assign shop_collection = collections[section.settings.collection]
  assign product_count = section.settings.product_count | default: 8
  assign columns = section.settings.columns_desktop | default: 4
-%}

<section class="pl-shop sec" data-scene="{{ scene }}" style="--shelf-desktop-cols: {{ columns }};">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="d2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p class="lede">{{ section.settings.lede }}</p>{%- endif -%}
      <div class="rule">
        <i></i>
        {% render 'hero-icon', icon: 'leaf' %}
        <i></i>
      </div>
    </div>

    {%- if shop_collection != blank and shop_collection.products_count > 0 -%}
      <div class="shelf">
        {%- for product in shop_collection.products limit: product_count -%}
          {% render 'product-card',
             product: product,
             variant: 'grid',
             show_rating: section.settings.show_rating,
             show_badge: section.settings.show_badge,
             show_cta: true,
             cta_behaviour: section.settings.cta_behaviour,
             image_width: 400,
             loading: 'lazy',
             index: forloop.index0 %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shop-empty glass sec-pad rv">
        {{ 'sections.shop.empty' | t }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.shop.name",
  "tag": "section",
  "class": "pl-shop-section",
  "settings": [
    { "type": "range", "id": "scene", "label": "t:sections.shop.scene", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "kicker", "label": "t:sections.shop.kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "t:sections.shop.heading", "default": "Loved by 30,000 homes" },
    { "type": "textarea", "id": "lede", "label": "t:sections.shop.lede" },
    { "type": "collection", "id": "collection", "label": "t:sections.shop.collection" },
    { "type": "range", "id": "product_count", "label": "t:sections.shop.product_count", "min": 2, "max": 24, "step": 1, "default": 8 },
    {
      "type": "select", "id": "columns_desktop", "label": "t:sections.shop.columns_desktop", "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "checkbox", "id": "show_rating", "label": "t:sections.shop.show_rating", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "t:sections.shop.show_badge", "default": true },
    {
      "type": "select", "id": "cta_behaviour", "label": "t:sections.shop.cta_behaviour", "default": "add_to_cart",
      "options": [
        { "value": "add_to_cart", "label": "t:sections.shop.cta_add" },
        { "value": "view_product", "label": "t:sections.shop.cta_view" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.shop.name" }]
}
{% endschema %}
